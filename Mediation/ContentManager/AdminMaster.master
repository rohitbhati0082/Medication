    <div class="collapse" id="ui-event">
        <ul class="nav flex-column sub-menu">
            <li class="nav-item">
                <a class="nav-link" href="NationalEvent.aspx">National</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="IntNationalEvent.aspx">International</a>
            </li>
             <li class="nav-item">
     <a class="nav-link" href="PhotosEvent.aspx">Photo Gallery</a>
 </li>
                         <li class="nav-item">
    <a class="nav-link" href="VideosEvent.aspx">Video Gallery</a>
</li>
                        <li class="nav-item">
    <a class="nav-link" href="Certificates.aspx">Certifications/pdf</a>
</li>
        </ul>
    </div>
</li>


                    </ul>
                </nav>

                <div class="main-panel">
                    <div class="content-wrapper">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
